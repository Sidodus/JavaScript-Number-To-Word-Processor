{
  "name": "javascript-number-to-word-processor-monorepo",
  "version": "4.1.0",
  "private": true,
  "description": "Monorepo for JSnumberToWordProcessor v4 - the core NPM library and the Next.js quick-usage UI.",
  "license": "MIT",
  "author": "Saheed Odulaja",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sidodus/JavaScript-Number-To-Word-Processor.git"
  },
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=18.18.0"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,mjs,json,md,scss,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,mjs,json,md,scss,css}\"",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build:core && npm run build:ui",
    "build:core": "npm run build --workspace js-number-to-word-processor",
    "build:ui": "npm run build --workspace @jsnumber/ui",
    "dev:ui": "npm run dev --workspace @jsnumber/ui",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.46.0",
    "@typescript-eslint/parser": "^8.46.0",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "fast-check": "^4.10.2",
    "prettier": "^3.4.2",
    "tsup": "^8.3.6",
    "typescript": "^5.7.3",
    "vitest": "^2.1.9"
  }
}
